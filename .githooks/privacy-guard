#!/usr/bin/env bash
# Privacy guard: blocca commit/push di dati personali, database, export sanitari e segreti.
# Uso: privacy-guard --staged            (pre-commit: contenuto in staging)
#      privacy-guard --range BASE HEAD   (pre-push: tutti i commit che stanno per essere pubblicati)
# Attivazione (una volta per clone): git config core.hooksPath .githooks
set -euo pipefail

mode="${1:---staged}"
if [ "$mode" = "--range" ]; then
  diff_args=("$2" "$3"); what="push"; What="Push"
else
  diff_args=(--cached); what="commit"; What="Commit"
fi

fail=0
err() { printf '✗ %s\n' "$1" >&2; fail=1; }
root="$(git rev-parse --show-toplevel)"
noreply='@users\.noreply\.github\.com$'

# 0a) Identità: autore e committer devono usare l'indirizzo noreply di GitHub (nessuna email personale nello storico)
if [ "$mode" = "--range" ]; then
  while IFS= read -r ident; do
    [ -z "$ident" ] && continue
    printf '%s\n' "$ident" | grep -Eq "$noreply" || err "commit con autore/committer non noreply: ${ident%% *}"
  done < <(git log --format='%h %ae%n%h %ce' "$2..$3" 2>/dev/null || git log --format='%h %ae%n%h %ce' "$3")
else
  for var in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
    email=$(git var "$var" | sed -E 's/.*<([^>]*)>.*/\1/')
    printf '%s\n' "$email" | grep -Eq "$noreply" || err "$var non usa l'indirizzo noreply di GitHub"
  done
  # 0b) Backup privato dei file locali dell'assistente (elenco in private/backup_list.txt)
  if [ -f "$root/private/backup_list.txt" ]; then
    mkdir -p "$root/private/agent-config"
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      case "$f" in \#*) continue ;; esac
      [ -e "$root/$f" ] && mkdir -p "$root/private/agent-config/$(dirname "$f")" && cp -p "$root/$f" "$root/private/agent-config/$f"
    done < "$root/private/backup_list.txt"
  fi
fi

staged=$(git diff "${diff_args[@]}" --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  [ "$fail" -ne 0 ] && { echo "$What bloccato dal privacy guard." >&2; exit 1; }
  exit 0
fi

# 1) Percorsi e tipi di file vietati (generici + elenco privato private/blocked_paths.txt)
blocked_paths='^(data|private|reports)/|(^|/)[^/]*\.local\.md$|(^|/)settings\.local\.json$|(^|/)\.env|\.(db|db-wal|db-shm|sqlite|sqlite3|ndjson|heic|HEIC|jpe?g|JPE?G|pdf|PDF)$|(^|/)(export\.zip|export\.xml|export_cda\.xml)$|apple_health_export'
while IFS= read -r f; do
  if printf '%s\n' "$f" | grep -Eq "$blocked_paths"; then
    err "file vietato in $what: $f"
  fi
done <<< "$staged"
if [ -f "$root/private/blocked_paths.txt" ]; then
  while IFS= read -r rx; do
    [ -z "$rx" ] && continue
    case "$rx" in \#*) continue ;; esac
    while IFS= read -r f; do
      printf '%s\n' "$f" | grep -Eq -- "$rx" && err "file vietato in $what (elenco privato): $f"
    done <<< "$staged"
  done < "$root/private/blocked_paths.txt"
fi

# 2) Contenuto aggiunto: segreti, percorsi locali, email personali
added=$(git diff "${diff_args[@]}" -U0 --no-color --diff-filter=ACMR | grep -E '^\+' | grep -Ev '^\+\+\+ ' || true)

secret_patterns=(
  'gh[pousr]_[A-Za-z0-9]{36,}'
  'github_pat_[A-Za-z0-9_]{50,}'
  'sk-ant-[A-Za-z0-9_-]{20,}'
  'sk-[A-Za-z0-9]{32,}'
  'AKIA[0-9A-Z]{16}'
  'xox[abprs]-[A-Za-z0-9-]{10,}'
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
)
for p in "${secret_patterns[@]}"; do
  if printf '%s\n' "$added" | grep -Eq -- "$p"; then err "possibile segreto (pattern: $p)"; fi
done

if printf '%s\n' "$added" | grep -Eq '/Users/[A-Za-z0-9._-]+|/home/[A-Za-z0-9._-]+'; then
  err "percorso locale con nome utente nel contenuto"
fi

emails=$(printf '%s\n' "$added" | grep -Eo '[A-Za-z0-9][A-Za-z0-9._%+-]*@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}' \
  | grep -Ev '@users\.noreply\.github\.com$|@example\.(com|org)$' || true)
if [ -n "$emails" ]; then err "email nel contenuto: $(printf '%s ' $emails)"; fi

# 3) Denylist privata (stringhe personali, file escluso da git)
denylist="$root/private/denylist.txt"
if [ -f "$denylist" ]; then
  while IFS= read -r term; do
    [ -z "$term" ] && continue
    case "$term" in \#*) continue ;; esac
    if printf '%s\n' "$added" | grep -Fqi -- "$term"; then err "termine in denylist privata trovato nel contenuto"; fi
  done < "$denylist"
fi

# 4) gitleaks, se installato
if command -v gitleaks >/dev/null 2>&1; then
  if [ "$mode" = "--staged" ]; then
    gitleaks protect --staged --redact --no-banner >/dev/null 2>&1 || err "gitleaks ha rilevato segreti"
  fi
fi

if [ "$fail" -ne 0 ]; then
  echo "$What bloccato dal privacy guard. Rimuovi i file/dati indicati (non usare --no-verify)." >&2
  exit 1
fi
exit 0
