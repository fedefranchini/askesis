#!/usr/bin/env bash
# Privacy guard: blocca commit di dati personali, database, export sanitari e segreti.
# Attivazione (una volta per clone): git config core.hooksPath .githooks
set -euo pipefail

fail=0
err() { printf '✗ %s\n' "$1" >&2; fail=1; }

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 1) Percorsi e tipi di file vietati
blocked_paths='^(data|private|reports)/|(^|/)assistant\.local\.md$|(^|/)settings\.local\.json$|(^|/)\.env|\.(db|db-wal|db-shm|sqlite|sqlite3|ndjson|heic|HEIC|jpe?g|JPE?G|pdf|PDF)$|(^|/)(export\.zip|export\.xml|export_cda\.xml)$|apple_health_export'
while IFS= read -r f; do
  if printf '%s\n' "$f" | grep -Eq "$blocked_paths"; then
    err "file vietato in commit: $f"
  fi
done <<< "$staged"

# 2) Contenuto aggiunto: segreti, percorsi locali, email personali
added=$(git diff --cached -U0 --no-color --diff-filter=ACMR | grep -E '^\+' | grep -Ev '^\+\+\+ ' || true)

secret_patterns=(
  'gh[pousr]_[A-Za-z0-9]{36,}'
  'github_pat_[A-Za-z0-9_]{50,}'
  'sk-ant-[A-Za-z0-9_-]{20,}'
  'sk-[A-Za-z0-9]{32,}'
  'AKIA[0-9A-Z]{16}'
  'xox[abprs]-[A-Za-z0-9-]{10,}'
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
)
for p in "${secret_patterns[@]}"; do
  if printf '%s\n' "$added" | grep -Eq -- "$p"; then err "possibile segreto (pattern: $p)"; fi
done

if printf '%s\n' "$added" | grep -Eq '/Users/[A-Za-z0-9._-]+|/home/[A-Za-z0-9._-]+'; then
  err "percorso locale con nome utente nel contenuto"
fi

emails=$(printf '%s\n' "$added" | grep -Eo '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}' \
  | grep -Ev '@users\.noreply\.github\.com$|@example\.(com|org)$' || true)
if [ -n "$emails" ]; then err "email nel contenuto: $(printf '%s ' $emails)"; fi

# 3) Denylist privata (stringhe personali, file escluso da git)
denylist="private/denylist.txt"
if [ -f "$denylist" ]; then
  while IFS= read -r term; do
    [ -z "$term" ] && continue
    case "$term" in \#*) continue ;; esac
    if printf '%s\n' "$added" | grep -Fqi -- "$term"; then err "termine in denylist privata trovato nel contenuto"; fi
  done < "$denylist"
fi

# 4) gitleaks, se installato
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact --no-banner >/dev/null 2>&1 || err "gitleaks ha rilevato segreti"
fi

if [ "$fail" -ne 0 ]; then
  echo "Commit bloccato dal privacy guard. Rimuovi i file/dati indicati (non usare --no-verify)." >&2
  exit 1
fi
exit 0
