#!/usr/bin/env bash
# Blocca attribuzioni automatiche a assistant nei messaggi di commit: l'autore è sempre il proprietario.
set -euo pipefail
if grep -Eiq 'Co-Authored-By:.*(assistant|anthropic)|Generated with \[?AI assistant' "$1"; then
  echo "✗ Messaggio di commit con attribuzione a assistant: rimuovila." >&2
  exit 1
fi
